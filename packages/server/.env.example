# Copy to .env and adjust. Every value is validated at startup; the process
# refuses to boot rather than running with a malformed configuration.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# REQUIRED IN PRODUCTION. At least 32 characters.
#   openssl rand -base64 48
SESSION_SECRET=
SESSION_TTL_MS=86400000

# Exact origins allowed to call the API from a browser. Comma-separated.
CORS_ALLOWED_ORIGINS=http://localhost:5173

RESERVATION_HOLD_MS=120000
RESERVATION_RETENTION_MS=3600000
SWEEP_INTERVAL_MS=5000
LOCK_ACQUIRE_TIMEOUT_MS=5000

IDEMPOTENCY_TTL_MS=600000
IDEMPOTENCY_MAX_ENTRIES=50000

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
RATE_LIMIT_WRITE_MAX=60

BODY_LIMIT=4kb

# Enable only when the process genuinely sits behind a trusted proxy.
TRUST_PROXY=false
